{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/icesurf666/architecture-policy-kit/policy/schema.json",
  "title": "Architecture review policy pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policies"],
  "properties": {
    "version": { "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "kind",
        "severity",
        "statement",
        "reason",
        "review_instruction",
        "evidence_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "kind": {
          "enum": ["deterministic", "semantic", "mixed"]
        },
        "severity": {
          "enum": ["block", "warn"]
        },
        "statement": { "type": "string", "minLength": 20 },
        "reason": { "type": "string", "minLength": 20 },
        "review_instruction": { "type": "string", "minLength": 20 },
        "evidence_required": { "type": "boolean" },
        "deterministic_enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "description"],
          "properties": {
            "mechanism": {
              "enum": ["eslint", "ast", "unit-test", "integration-test", "other"]
            },
            "description": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  }
}
